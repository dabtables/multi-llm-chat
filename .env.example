# Multi-LLM Chatbot Environment Variables

# 1. PIN Authentication
# The secret PIN users must enter to access the application
APP_PIN=2468
# A secure random secret used to sign the session JWT cookie (min 32 characters)
PIN_SESSION_SECRET=super_secret_session_jwt_key_32_characters_long_min

# 2. OpenRouter API
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional OpenRouter headers for leaderboard attribution
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Multi-LLM Chat

# 3. Supabase Configuration
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Service role key for server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
